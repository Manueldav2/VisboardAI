{
  "name": "gideon-listener",
  "productName": "Gideon Listener",
  "version": "0.4.0",
  "description": "Turn on Gideon before a meeting — it listens and maps your thinking live.",
  "main": "main.js",
  "author": "Manuel David",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.visboard.gideon.listener",
    "productName": "Gideon Listener",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "afterPack": "scripts/sign-helpers.js",
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "github",
      "owner": "Manueldav2",
      "repo": "VisboardAI"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "renderer/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": 1,
        "NSMicrophoneUsageDescription": "Gideon listens to your voice to build live thought maps.",
        "NSScreenCaptureUsageDescription": "Gideon captures system audio so it can hear the whole meeting.",
        "NSCameraUsageDescription": "Gideon detects when you join a video call so it can offer to take notes."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "dmg": {
      "title": "Gideon Listener"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
